{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "prod"
    },
    "resourceGroupName": {
      "value": "ghes-research-prod-rg"
    },
    "location": {
      "value": "eastus"
    },
    "vmName": {
      "value": "ghes-research-prod-vm"
    },
    "vmSize": {
      "value": "Standard_D16s_v3"
    },
    "osDiskSizeGB": {
      "value": 200
    },
    "dataDiskSizeGB": {
      "value": 1024
    },
    "imagePublisher": {
      "value": "GitHub"
    },
    "imageOffer": {
      "value": "GitHub-Enterprise"
    },
    "imageSku": {
      "value": "github-enterprise-gen2"
    },
    "imageVersion": {
      "value": "3.22.2"
    },
    "nicName": {
      "value": "ghes-research-prod-nic"
    },
    "subnetId": {
      "value": "/subscriptions/<SUB_ID>/resourceGroups/ghes-research-network-rg/providers/Microsoft.Network/virtualNetworks/ghes-research-vnet/subnets/prod-subnet"
    },
    "privateIpAddress": {
      "value": "10.1.3.10"
    },
    "privateIpAllocationMethod": {
      "value": "Static"
    },
    "enablePublicIp": {
      "value": false
    },
    "enableCmkEncryption": {
      "value": true
    },
    "diskEncryptionSetId": {
      "value": "/subscriptions/<SUB_ID>/resourceGroups/ghes-research-security-rg/providers/Microsoft.Compute/diskEncryptionSets/ghes-research-des"
    },
    "adminUsername": {
      "value": "ghesadmin"
    },
    "enableMonitoring": {
      "value": true
    },
    "logRetentionDays": {
      "value": 180
    },
    "tags": {
      "value": {
        "Environment": "prod",
        "Project": "GHES-Self-Healing-Research",
        "Paper": "ICPADS-2026",
        "Owner": "josiah1chuku",
        "BackupEnabled": "true"
      }
    },
    "adminSshPublicKey": {
      "value": "<PASTE_SSH_PUBLIC_KEY>"
    }
  }
}
